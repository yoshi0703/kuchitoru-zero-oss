# Browser-safe values. These are embedded in the web build.
VITE_APP_ORIGIN=http://localhost:5173
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_GOOGLE_AUTH_ENABLED=false

# Required Edge Function secrets. Set these with `supabase secrets set` in
# Supabase Cloud or in deploy/self-hosted/supabase/.env for Docker. Never use
# a VITE_ prefix for these values.
# ALLOWED_ORIGINS=https://community.example.com
# MEO_APP_ORIGIN=https://community.example.com
# AI_CREDENTIALS_MASTER_KEY_V1=replace-with-32-byte-standard-base64-key
# AI_CREDENTIALS_ACTIVE_KEY_VERSION=1
# SESSION_TOKEN_DERIVATION_KEY=replace-with-32-byte-standard-base64-key
# RATE_LIMIT_HMAC_KEY=replace-with-32-byte-standard-base64-key
# TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
# COMMUNITY_GIT_SHA=replace-with-full-40-character-git-sha

# Optional model IDs. A provider is enabled only when its INTERVIEW, REVIEW,
# and REWRITE values are all set. Leave all three blank for providers you do
# not use. All providers may remain blank; non-AI APIs will still start.
# OPENAI_INTERVIEW_MODEL=replace-with-model-id
# OPENAI_REVIEW_MODEL=replace-with-model-id
# OPENAI_REWRITE_MODEL=replace-with-model-id
# GEMINI_INTERVIEW_MODEL=replace-with-model-id
# GEMINI_REVIEW_MODEL=replace-with-model-id
# GEMINI_REWRITE_MODEL=replace-with-model-id
# DEEPSEEK_INTERVIEW_MODEL=replace-with-model-id
# DEEPSEEK_REVIEW_MODEL=replace-with-model-id
# DEEPSEEK_REWRITE_MODEL=replace-with-model-id
# XAI_INTERVIEW_MODEL=replace-with-model-id
# XAI_REVIEW_MODEL=replace-with-model-id
# XAI_REWRITE_MODEL=replace-with-model-id
# ANTHROPIC_INTERVIEW_MODEL=replace-with-model-id
# ANTHROPIC_REVIEW_MODEL=replace-with-model-id
# ANTHROPIC_REWRITE_MODEL=replace-with-model-id

# Optional Google Business Profile OAuth connection. Set all three together.
# GOOGLE_BUSINESS_CLIENT_ID=replace-with-google-oauth-client-id
# GOOGLE_BUSINESS_CLIENT_SECRET=replace-with-google-oauth-client-secret
# GOOGLE_BUSINESS_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/meo-api/oauth/google/callback

# Optional Instagram OAuth connection. Set the first three together.
# INSTAGRAM_APP_ID=replace-with-instagram-app-id
# INSTAGRAM_APP_SECRET=replace-with-instagram-app-secret
# INSTAGRAM_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/meo-api/oauth/instagram/callback
# INSTAGRAM_API_VERSION=v25.0

# Optional background jobs. Keep disabled unless an authenticated scheduler is
# configured to call meo-jobs.
# MEO_JOBS_ENABLED=false
# MEO_JOBS_TOKEN=replace-with-at-least-32-random-characters
# MEO_JOBS_WORKER_ID=meo-jobs
# MEO_JOBS_BATCH_LIMIT=10
# MEO_JOBS_LEASE_SECONDS=180

# Optional operational rate limits. These protect the operator's own external
# accounts from excess requests; they are not plans, credits, or trial limits.
# MEO_AI_DRAFT_STORE_DAILY_LIMIT=20
# MEO_AI_DRAFT_GLOBAL_DAILY_LIMIT=500
# MEO_RANK_STORE_DAILY_LIMIT=1
# MEO_DATAFORSEO_RANK_GLOBAL_DAILY_POINT_LIMIT=1000
