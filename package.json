{
  "name": "kuchitoru-zero-community",
  "private": true,
  "version": "1.0.0",
  "description": "クチトルZERO Community — 店舗向けMEOと口コミ収集のセルフホスト対応OSS",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.integration.json --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:edge": "deno test --frozen --config supabase/functions/deno.json --allow-env supabase/functions",
    "format:edge": "deno fmt --check supabase/functions",
    "lint:edge": "deno lint supabase/functions",
    "typecheck:edge": "deno check --frozen --config supabase/functions/deno.json supabase/functions/main/index.ts supabase/functions/owner-api/index.ts supabase/functions/meo-api/index.ts supabase/functions/meo-workspace/index.ts supabase/functions/meo-jobs/index.ts supabase/functions/public-interview/index.ts",
    "test:db": "supabase test db --local supabase/tests/database",
    "test:e2e": "playwright test",
    "test:e2e:integration": "node scripts/run-local-integration-e2e.mjs",
    "prebuild": "node scripts/generate-security-headers.mjs && node scripts/generate-deployment-metadata.mjs",
    "build": "tsc -b && vite build && node scripts/copy-public-assets.mjs && node scripts/verify-client-bundle-secrets.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "verify:community": "node scripts/verify-community-boundaries.mjs",
    "verify:licenses": "node scripts/check-licenses.mjs",
    "verify:secrets": "node scripts/verify-client-bundle-secrets.mjs",
    "self-host": "sh scripts/self-host.sh",
    "check": "corepack pnpm verify:community && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.110.2",
    "@tanstack/react-query": "5.101.2",
    "clsx": "2.1.1",
    "framer-motion": "12.42.2",
    "gen-interface-jp": "0.8.0",
    "lucide-react": "1.24.0",
    "motion": "13.1.0",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-router": "8.3.1",
    "react-use-measure": "2.1.7",
    "tailwind-merge": "3.6.0",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "deno": "2.9.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
